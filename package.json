{
  "name": "photo-gallery",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:quality": "eslint --no-inline-config --config eslint.quality.config.mjs \"app/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"config/**/*.{ts,tsx}\" \"stores/**/*.{ts,tsx}\"",
    "lint:guardrails": "eslint --no-inline-config --config eslint.guardrails.config.mjs \"app/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"config/**/*.{ts,tsx}\" \"stores/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "lint:typed": "eslint --no-inline-config --config eslint.typed.config.mjs \"app/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"config/**/*.{ts,tsx}\" \"stores/**/*.{ts,tsx}\"",
    "lint:casts-doc": "node scripts/check-sanctioned-casts.mjs",
    "lint:deps": "knip --include unlisted,binaries",
    "lint:deadcode": "node scripts/check-knip-ratchet.mjs",
    "lint:gates": "node scripts/check-gate-inventory.mjs",
    "lint:rules": "node scripts/check-rules-doc.mjs",
    "knip": "knip",
    "dup": "jscpd",
    "audit:deps": "pnpm audit --audit-level=high",
    "test:coverage-ratchet": "node scripts/check-coverage-ratchet.mjs",
    "format": "prettier --write app lib components features config stores scripts tooling .github \"*.md\" \"*.json\" \"*.mjs\" \"*.js\"",
    "format:check": "prettier --check app lib components features config stores scripts tooling .github \"*.md\" \"*.json\" \"*.mjs\" \"*.js\"",
    "check:quick": "pnpm typecheck && vitest run --changed",
    "check:agent": "node scripts/run-gates.mjs",
    "eval": "node scripts/run-evals.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm lint:quality && pnpm lint:guardrails && pnpm lint:typed && pnpm lint:casts-doc && pnpm lint:gates && pnpm lint:rules && pnpm dup && pnpm lint:deps",
    "verify:full": "pnpm verify && pnpm build && pnpm test",
    "rules:test": "vitest run tooling/eslint-rules",
    "gen": "node scripts/gen.mjs",
    "skill:sync": "node scripts/gen-dev-skill.mjs",
    "skill:check": "node scripts/gen-dev-skill.mjs --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "next": "^15.5.4",
    "pino": "^9.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/eslint-plugin": "^1.3.4",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-max-params": "^1.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.4.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^61.0.2",
    "exifr": "^7.1.3",
    "jscpd": "^5.0.14",
    "jsdom": "^30.0.1",
    "knip": "^6.29.0",
    "lefthook": "^1.10.1",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18 <9"
    }
  }
}
