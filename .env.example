NODE_ENV=development

# Raw base URL of the public image repo, no trailing slash.
NEXT_PUBLIC_IMAGE_REPO_BASE=https://raw.githubusercontent.com/<owner>/gallery-images/main

# sha-256 hex of the shared gallery password. Generate with:
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('yourpassword')).then(d => console.log(Buffer.from(d).toString('hex')))"
NEXT_PUBLIC_GALLERY_PASSWORD_HASH=

# Set to /<repo-name> when deploying to <owner>.github.io/<repo-name>; empty for a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Optional: only used by pnpm eval.
ANTHROPIC_API_KEY=
