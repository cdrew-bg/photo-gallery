use-node-version=22.23.1

# Release-age cooldown: refuse dependency versions published less than 3 days ago.
# Nearly every recent npm account compromise was caught within days of the malicious
# publish, so a cooldown turns that class of incident into a non-event at ~zero cost.
# Honored by pnpm 10.16+; inert on 9.x.
minimum-release-age=4320
